{
  "name": "effect-native",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenAgentsInc/effect-native.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "bun test ./packages/*/test ./scripts ./examples/guide-app",
    "check:doc-snippets": "bun run scripts/check-doc-snippets.ts",
    "check:catalog-reference": "bun run scripts/check-catalog-reference.ts",
    "check": "bun run typecheck && bun run test && bun run check:doc-snippets && bun run check:catalog-reference",
    "example:web": "bun build ./examples/web/main.ts --outfile ./examples/web/public/app.js --format esm && bun ./examples/web/server.ts",
    "example:guide": "bun build ./examples/guide-app/web.ts --outfile ./examples/guide-app/public/app.js --format esm && bun ./examples/guide-app/server.ts",
    "gallery": "bun build ./examples/gallery/main.ts --outfile ./examples/gallery/public/app.js --format esm && bun ./examples/gallery/server.ts",
    "gallery:build": "bun ./scripts/build-gallery.ts",
    "example:desktop-khala-chat": "bun build ./examples/desktop-khala-chat/main.ts --outfile ./examples/desktop-khala-chat/public/app.js --format esm && bun ./examples/desktop-khala-chat/server.ts",
    "devtools": "bun build ./packages/devtools/src/panel-main.ts --outfile ./packages/devtools/public/panel.js --format esm && bun ./packages/devtools/src/server.ts",
    "site:content": "bun ./scripts/generate-site-content.ts",
    "site": "bun run site:content && bun build ./examples/site/main.ts --outfile ./examples/site/public/app.js --format esm && bun ./examples/site/server.ts",
    "site:build": "bun ./scripts/build-site.ts",
    "baselines:bless": "bun packages/testkit/scripts/bless-baselines.ts"
  },
  "dependencies": {
    "@effect-native/core": "workspace:*",
    "@effect-native/devtools": "workspace:*",
    "@effect-native/gallery": "workspace:*",
    "@effect-native/platform-desktop": "workspace:*",
    "@effect-native/platform-electron": "workspace:*",
    "@effect-native/platform-mobile": "workspace:*",
    "@effect-native/render-canvas": "workspace:*",
    "@effect-native/render-dom": "workspace:*",
    "@effect-native/render-rn": "workspace:*",
    "@effect-native/site": "workspace:*",
    "@effect-native/testkit": "workspace:*",
    "@effect-native/tokens": "workspace:*",
    "effect": "4.0.0-beta.94"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/bun": "latest",
    "fast-check": "4.8.0",
    "happy-dom": "^20.10.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "5.8.3"
  }
}
